<style>
    .bulk-unlock-card {
        border-radius: 0.75rem;
        background:
            radial-gradient(circle at top left, rgba(251, 191, 36, 0.34), transparent 32%),
            radial-gradient(circle at bottom right, rgba(251, 113, 133, 0.28), transparent 38%),
            linear-gradient(135deg, rgba(67, 20, 7, 0.96), rgba(154, 52, 18, 0.92) 52%, rgba(185, 28, 28, 0.95));
        background-size: 160% 160%;
        box-shadow: 0 20px 48px rgba(8, 47, 73, 0.34);
        animation: bulkUnlockGradientShift 8s ease-in-out infinite;
        will-change: background-position, transform;
    }

    .bulk-unlock-card::before {
        content: '';
        position: absolute;
        inset: -12% -30%;
        background:
            linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.05) 40%, rgba(255, 255, 255, 0.14) 50%, rgba(255, 255, 255, 0.05) 60%, transparent 82%);
        opacity: 0.55;
        filter: blur(8px);
        transform: translate3d(-12%, 0, 0);
        animation: bulkUnlockShadeDrift 9s ease-in-out infinite;
        pointer-events: none;
        z-index: 0;
        will-change: transform, opacity;
    }

    .bulk-unlock-card::after {
        content: '';
        position: absolute;
        inset: 1px;
        border-radius: inherit;
        border: 1px solid rgba(255, 255, 255, 0.12);
        pointer-events: none;
        z-index: 0;
    }

    .bulk-unlock-card--interactive {
        animation: bulkUnlockGradientShift 8s ease-in-out infinite, bulkUnlockFloat 3.6s ease-in-out infinite;
    }

    .bulk-unlock-surface {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.03)),
            rgba(8, 15, 32, 0.2);
    }

    .bulk-unlock-content {
        background:
            linear-gradient(90deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04) 48%, rgba(255, 255, 255, 0.08));
    }

    .bulk-unlock-emblem {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.92), rgba(220, 38, 38, 0.95));
        box-shadow: 0 10px 24px rgba(127, 29, 29, 0.34);
    }

    .bulk-unlock-emblem::after {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        opacity: 0.85;
    }

    .bulk-unlock-emblem--locked {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.96), rgba(51, 65, 85, 0.95));
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.32);
    }

    .bulk-unlock-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.65rem;
        padding: 0.2rem 0.7rem;
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .bulk-unlock-chip--promo {
        color: white;
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.95), rgba(225, 29, 72, 0.92));
    }

    .bulk-unlock-chip--count {
        color: rgba(255, 255, 255, 0.96);
        background: rgba(15, 23, 42, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .bulk-unlock-chip--ghost {
        color: rgba(255, 255, 255, 0.78);
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .bulk-unlock-title {
        display: block;
        color: white;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .bulk-unlock-subtitle {
        display: block;
        color: rgba(255, 255, 255, 0.76);
        font-size: 0.83rem;
        line-height: 1.45;
        max-width: 38rem;
    }

    .bulk-unlock-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        min-height: 3rem;
        padding: 0.8rem 1.2rem;
        border-radius: 9999px;
        color: white;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.08));
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
        transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
    }

    .bulk-unlock-action-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.14);
    }

    .bulk-unlock-action--login {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.26), rgba(220, 38, 38, 0.18));
    }

    .bulk-unlock-card--interactive:hover .bulk-unlock-action {
        transform: translateY(-1px);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
        border-color: rgba(255, 255, 255, 0.22);
    }

    @media (max-width: 640px) {
        .bulk-unlock-title {
            font-size: 0.95rem;
        }

        .bulk-unlock-subtitle {
            font-size: 0.78rem;
        }
    }

    @keyframes bulkUnlockGradientShift {

        0%,
        100% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }
    }

    @keyframes bulkUnlockShimmer {
        0% {
            transform: translateX(-140%) rotate(8deg);
        }

        100% {
            transform: translateX(220%) rotate(8deg);
        }
    }

    @keyframes bulkUnlockFloat {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    @keyframes bulkUnlockShadeDrift {

        0%,
        100% {
            transform: translate3d(-12%, 0, 0);
            opacity: 0.38;
        }

        50% {
            transform: translate3d(12%, 0, 0);
            opacity: 0.6;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .bulk-unlock-card,
        .bulk-unlock-card--interactive,
        .bulk-unlock-card::before {
            animation: none;
        }
    }
</style>
