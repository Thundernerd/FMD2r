<script>
let countdown = 0;
const closeBtn = document.getElementById('popup_close_btn');

if (countdown > 0) {
    const timer = setInterval(() => {
        countdown--;
        if (countdown > 0) {
            closeBtn.textContent = countdown + 's';
        } else {
            clearInterval(timer);
            closeBtn.innerHTML =
                '<img class="w-6" src="https://api.iconify.design/material-symbols:close-rounded.svg?color=white" />';
            closeBtn.disabled = false;
            closeBtn.classList.remove('cursor-not-allowed');
            closeBtn.classList.add('cursor-pointer');
        }
    }, 1000);
}

function closePopupBanner(button) {
    document.cookie = "popup_banner=true; path=/; max-age=" + (60 * 60 * 24 * 1); // 1 day
    button.closest('#popup_banner').style.display = 'none';
}

function runCardPromo(amount, button) {
        button.closest('#popup_banner').style.display = 'none';
    let login_panel_main = document.getElementById('login_panel_main');
    login_panel_main.classList.toggle('flex');
    login_panel_main.classList.toggle('hidden');
    }
</script>

