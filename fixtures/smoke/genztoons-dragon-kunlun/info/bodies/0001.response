    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            const wrapper = document.querySelector('.bookmark-wrapper');
            if (!wrapper) {
                return;
            }

            const seriesUid = "657595f9f1b";
            const studioUid = "fa0d78b3630";
            const toggleBtn = document.getElementById('view_main_bookmarks_list');
            const chevron = toggleBtn.querySelector('.bookmark-chevron img');
            const menuEl = document.getElementById('main_bookmarks_list');
            const typeOptions = document.querySelectorAll('.bookmark-type-option, .bookmark-remove-option');
            const notificationBtn = document.querySelector('.notification-toggle');
            const notificationIcon = notificationBtn.querySelector('img');

            if (!toggleBtn || !menuEl || !notificationBtn) {
                return;
            }

            // Fetch current bookmark using the site's access_token cookie
            const getBookmark = async () => {
                try {
                    const response = await fetch(
                        `/private/bookmark?studio_uid=${studioUid}&series_uid=${seriesUid}`, {
                            credentials: 'same-origin'
                        }
                    );

                    if (response.status === 401 || response.status === 403) {
                        return null;
                    }

                    const data = await response.json();
                    return data.bookmark;
                } catch (error) {
                    console.error('Error fetching bookmark:', error);
                    return null;
                }
            };

            const getNotification = async () => {
                try {
                    const response = await fetch(
                        `/private/series_notifications?series_uid=${seriesUid}&token=${document.cookie.split('access_token=')[1] || ''}`, {
                            credentials: 'same-origin'
                        }
                    );

                    if (response.status === 401 || response.status === 403) {
                        return null;
                    }

                    const data = await response.json();
                    if (!data.success || !data.data) {
                        return null;
                    }

                    return Array.isArray(data.data) ? (data.data[0] ?? null) : data.data;
                } catch (error) {
                    console.error('Error fetching notification state:', error);
                    return null;
                }
            };

            const updateNotificationUI = (enabled, canToggle) => {
                notificationBtn.dataset.enabled = enabled ? 'true' : 'false';
                notificationBtn.disabled = !canToggle;

                if (canToggle) {
                    notificationBtn.classList.remove('opacity-50');
                    notificationBtn.classList.add('opacity-100', 'cursor-pointer');
                    notificationBtn.title = enabled ? 'Disable notifications' : 'Enable notifications';
                } else {
                    notificationBtn.classList.add('opacity-50');
                    notificationBtn.classList.remove('opacity-100', 'cursor-pointer');
                    notificationBtn.title = 'Enable notifications (requires bookmark)';
                }

                if (enabled) {
                    notificationBtn.classList.add('text-white', 'bg-white/20');
                    notificationIcon.src =
                        'https://api.iconify.design/material-symbols:notifications-active.svg?color=white';
                } else {
                    notificationBtn.classList.remove('text-white', 'bg-white/20');
                    notificationIcon.src =
                        'https://api.iconify.design/material-symbols:notifications.svg?color=white';
                }
            };

            const setNotification = async (enabled) => {
                const response = await fetch('/private/series_notifications', {
                    method: enabled ? 'POST' : 'DELETE',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        studio_uid: studioUid,
                        series_uid: seriesUid
                    })
                });

                if (response.status === 401 || response.status === 403) {
                    return {
                        authRequired: true,
                        success: false
                    };
                }

                const data = await response.json();
                return {
                    authRequired: false,
                    ...data
                };
            };

            // Icon mapping for types
            const iconMap = {
                0: 'material-symbols:bookmark-outline',
                1: 'material-symbols:book-4',
                2: 'material-symbols:pause-circle',
                3: 'material-symbols:close-small',
                4: 'material-symbols:bookmark-add',
                5: 'material-symbols:check-circle',
                6: 'material-symbols:replay',
            };

            // Update UI based on bookmark
            const updateUI = (bookmark, notification) => {
                const type = bookmark ? bookmark.type : 0;
                const types = {
                    0: {
                        title: 'Add to Library',
                        color: 'bg-gray-500'
                    },
                    1: {
                        title: 'Reading',
                        color: 'bg-green-500'
                    },
                    2: {
                        title: 'On Hold',
                        color: 'bg-blue-500'
                    },
                    3: {
                        title: 'Dropped',
                        color: 'bg-red-500'
                    },
                    4: {
                        title: 'Plan to Read',
                        color: 'bg-purple-500'
                    },
                    5: {
                        title: 'Completed',
                        color: 'bg-amber-500'
                    },
                    6: {
                        title: 'Re-Reading',
                        color: 'bg-cyan-500'
                    },
                };

                // Update button title and icon
                toggleBtn.querySelector('.bookmark-title').textContent = types[type].title;
                const iconEl = toggleBtn.querySelector('.bookmark-icon img');
                iconEl.src = `https://api.iconify.design/${iconMap[type]}.svg?color=white`;

                // Update visual state
                if (type > 0) {
                    toggleBtn.classList.add('bookmarked');
                } else {
                    toggleBtn.classList.remove('bookmarked');
                }

                // Update check marks in menu
                typeOptions.forEach(opt => {
                    const optType = parseInt(opt.dataset.type);
                    const checkEl = opt.querySelector('.bookmark-check');

                    if (optType === type) {
                        opt.classList.add('selected');
                        checkEl?.classList.remove('hidden');
                    } else {
                        opt.classList.remove('selected');
                        checkEl?.classList.add('hidden');
                    }
                });

                updateNotificationUI(Boolean(notification), type > 0);
            };

            // Initial load
            toggleBtn.classList.add('bookmark-initial-loading');
            notificationBtn.classList.add('bookmark-initial-loading');
            toggleBtn.querySelector('.bookmark-title').textContent = 'Loading...';

            let currentBookmark = null;
            let currentNotification = null;

            try {
                currentBookmark = await getBookmark();
                currentNotification = currentBookmark ? await getNotification() : null;
                updateUI(currentBookmark, currentNotification);
            } finally {
                toggleBtn.classList.remove('bookmark-initial-loading');
                notificationBtn.classList.remove('bookmark-initial-loading');
            }

            // Toggle menu
            toggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();

                if (toggleBtn.classList.contains('bookmark-initial-loading')) {
                    return;
                }

                const isOpen = menuEl.classList.contains('open');

                if (!isOpen) {
                    menuEl.classList.remove('hidden');
                    menuEl.classList.remove('opacity-0');
                    menuEl.classList.add('open');
                    chevron.style.transform = 'rotate(180deg)';
                } else {
                    menuEl.classList.add('opacity-0');
                    setTimeout(() => {
                        menuEl.classList.add('hidden');
                    }, 150);
                    menuEl.classList.remove('open');
                    chevron.style.transform = 'rotate(0deg)';
                }
            });

            // Handle type selection
            typeOptions.forEach(opt => {
                opt.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    const selectedType = parseInt(opt.dataset.type);

                    // Add loading state
                    opt.classList.add('bookmark-loading');

                    try {
                        const response = await fetch('/private/bookmark', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                studio_uid: studioUid,
                                series_uid: seriesUid,
                                type: selectedType
                            })
                        });

                        if (response.status === 401 || response.status === 403) {
                            menuEl.classList.add('opacity-0');
                            setTimeout(() => {
                                menuEl.classList.add('hidden');
                                menuEl.classList.remove('open');
                            }, 150);
                            chevron.style.transform = 'rotate(0deg)';
                            alert('Please log in to use bookmarks.');
                            return;
                        }

                        const data = await response.json();
                        if (data.success) {
                            currentBookmark = await getBookmark();

                            if (!currentBookmark && currentNotification) {
                                const removedNotification = await setNotification(false);
                                if (!removedNotification.authRequired && removedNotification
                                    .success) {
                                    currentNotification = null;
                                }
                            }

                            if (currentBookmark) {
                                currentNotification = await getNotification();
                            } else {
                                currentNotification = null;
                            }

                            updateUI(currentBookmark, currentNotification);

                            // Close menu with animation
                            setTimeout(() => {
                                menuEl.classList.add('opacity-0');
                                setTimeout(() => {
                                    menuEl.classList.add('hidden');
                                    menuEl.classList.remove('open');
                                }, 150);
                                chevron.style.transform = 'rotate(0deg)';
                            }, 200);
                        } else {
                            console.error('Bookmark save failed:', data);
                        }
                    } catch (error) {
                        console.error('Error updating bookmark:', error);
                    } finally {
                        opt.classList.remove('bookmark-loading');
                    }
                });
            });

            notificationBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();

                if (notificationBtn.disabled) {
                    return;
                }

                notificationBtn.classList.add('bookmark-loading');

                try {
                    const shouldEnable = notificationBtn.dataset.enabled !== 'true';
                    const result = await setNotification(shouldEnable);

                    if (result.authRequired) {
                        alert('Please log in to manage notifications.');
                        return;
                    }

                    if (!result.success) {
                        console.error('Notification toggle failed:', result);
                        return;
                    }

                    currentNotification = shouldEnable ? (result.data ?? true) : null;
                    updateUI(currentBookmark, currentNotification);
                } catch (error) {
                    console.error('Error updating notification:', error);
                } finally {
                    notificationBtn.classList.remove('bookmark-loading');
                }
            });

            // Close menu on outside click
            document.addEventListener('click', (e) => {
                if (!wrapper.contains(e.target) && menuEl.classList.contains('open')) {
                    menuEl.classList.add('opacity-0');
                    setTimeout(() => {
                        menuEl.classList.add('hidden');
                        menuEl.classList.remove('open');
                    }, 150);
                    chevron.style.transform = 'rotate(0deg)';
                }
            });

            // Prevent body scroll on menu open (optional)
            menuEl.addEventListener('wheel', (e) => {
                if (menuEl.classList.contains('open')) {
                    e.preventDefault();
                }
            }, {
                passive: false
            });
        });
    </script>

