		var container = document.getElementById('divImage');
        var images = Array.from($('#divImage img'));
        var totalPages = images.length;
        var pageInput = document.getElementById('pageInput');
        var totalPagesSpan = document.getElementById('totalPages');
        totalPagesSpan.textContent = totalPages;
		
        var scrollHandling = {
            allow: true,
            reallow: function () {
                scrollHandling.allow = true;
            },
            delay: 50
        };

        $(window).scroll(function () {
            if (scrollHandling.allow) {
                var hT = $('#divImage').offset().top,
                wS = $(this).scrollTop();
                var srcb = getCookie('srcb');
                if (wS > hT && (srcb == null || srcb == 1)) {
                    $('.issue-fixed-container').css('display', 'block');
                } else {
                    $('.issue-fixed-container').css('display', 'none');
                }

                // set page number
                var currentPage = 1;
                for (let i = 0; i < images.length; i++) {
                    var rect = images[i].getBoundingClientRect();
                    if (rect.height + rect.top >= 0) {
                        currentPage = i + 1;
                        break;
                    }
                }

                pageInput.value = currentPage;
                var pgb = getCookie('pgb');
			    if (currentPage > 1 && (pgb == null || pgb == 1)) {
                    $('#pager').css('display', 'block');
                } else {
                    $('#pager').css('display', 'none');
                }

                scrollHandling.allow = false;
                setTimeout(scrollHandling.reallow, scrollHandling.delay);
            }
        });

        $('#btnHideIssueContainer').click(function () {
            alert("You can update settings to show the reading control bar again in Menu.");
            $('.issue-fixed-container').css('display', 'none');
            setCookie('srcb', 0, 360);
        });

        $('#btnHidePageContainer').click(function () {
            alert("You can update settings to show the pagination bar again in Menu.");
            $('#pager').css('display', 'none');
            setCookie('pgb', 0, 360);
        });

        

		
		
		// Input event: scroll to page
        function scrollToPage() {
            var page = parseInt(pageInput.value, 10);
            if (isNaN(page) || page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            pageInput.value = page;
            images[page - 1].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        pageInput.addEventListener('change', () => {
            scrollToPage()
        });
    </script>

