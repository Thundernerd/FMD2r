<body>
    
    <div class="shifter-page">
        <div class="header">
            <div class="wrap">
                
                <div id="topHolderBox" style="width: 230px; height: 30px;">
                    <img src="/Content/images/user-small.png" style="vertical-align: middle; margin-bottom: 5px">
                    Please <a class="red" href="/Login">login</a>
                    or <a class="red" href="/Register">register</a>
                </div>
                
		        <div class="headertop">
                    <a href="/" title="RcoStation.xyz - Read high quality comic online" class="logo"></a>
                    <div class="header_top_right">
                        <a href="javascript:void(0)" class="right_bt" id="openNav"><span class="btnCategories"></span></a>
                        <a href="/Shuffle" class="right_bt" id="shuffle"><span class="btnShuffle"></span></a>
                        
                    </div>
                    <div class="clear"></div>
			    </div>
                <div class="search_box">
                    <form action="/Search/Comic" method="post">
                        <input type="text" name="keyword" style="font-size: 16px;" />
                        <input type="submit" value="" />
                    </form>
                </div>
	  	    </div>
        </div>
        <div class="main">
            <div class="wrap">
                

<div id="ads-top-wrap" style="font-size: 0; position: relative; text-align: center; margin: 10px auto; width: 300px; overflow: hidden;">
    <div class="ads-top-1" style="float: left;">
        
    </div>
    <div class="ads-top-2" style="float: left;">
        <div id="pf-23066-1" data-format="display" data-lazy="true"></div>
        <script type="text/javascript">
            function setAd2() {
                if ($(window).width() >= 642) {
                    $('#ads-top-wrap').css('width', '610px');
                }
            }

            $(window).on("resize", function () {
                setAd2();
            });

            $(window).trigger("resize");
        </script>
    </div>
</div>
<div class="clear"></div>


                <div class="clear"></div>
                
    
    <div class="issue-fixed-container">
        <div class="content">
            <div style="margin: 0px auto;">
                
