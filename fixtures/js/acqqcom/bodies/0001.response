<script src="//gtimgcdn.ac.qq.com/media/js/json2.js"></script>
<![endif]-->
    <script>
        var DATA = '',
            PRELOAD_NUM = 2,
            NOTICE_TIME = 15,
            ROAST_SIZE = 1000,
            ROAST_PRE = 15,
            ROAST_VIEW = 15,
