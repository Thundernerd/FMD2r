{
	"name": "fmd2r-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "VITE_API_MOCK=true vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:real": "playwright test -c playwright.real.config.ts",
		"gen:api": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/schibsted-grotesk": "^5.3.0",
		"openapi-fetch": "^0.17.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
