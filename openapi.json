{
	"openapi": "3.1.0",
	"info": {
		"title": "FMD2r",
		"version": "0.0.0",
		"description": "Seed contract for the web UI skeleton (T22). fmd-server (T21) replaces this file with the document it generates with utoipa."
	},
	"paths": {
		"/api/inbox": {
			"get": {
				"operationId": "listInbox",
				"summary": "Inbox items, newest first",
				"responses": {
					"200": {
						"description": "Inbox items",
						"content": {
							"application/json": {
								"schema": { "type": "array", "items": { "$ref": "#/components/schemas/InboxItem" } }
							}
						}
					}
				}
			}
		},
		"/api/inbox/{id}/read": {
			"post": {
				"operationId": "markInboxRead",
				"summary": "Mark one inbox item as read",
				"parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
				"responses": {
					"204": { "description": "Marked as read" },
					"404": { "description": "No such inbox item" }
				}
			}
		},
		"/api/tasks": {
			"get": {
				"operationId": "listTasks",
				"summary": "Download tasks with their progress",
				"responses": {
					"200": {
						"description": "Tasks",
						"content": {
							"application/json": {
								"schema": { "type": "array", "items": { "$ref": "#/components/schemas/TaskProgress" } }
							}
						}
					}
				}
			}
		},
		"/api/resolve": {
			"post": {
				"operationId": "resolveUrl",
				"summary": "Find the module that handles a manga URL",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["url"],
								"properties": { "url": { "type": "string" } }
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The module and the module-relative link of the series",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/SeriesRef" } }
						}
					},
					"404": { "description": "No module handles this URL" }
				}
			}
		},
		"/api/events": {
			"get": {
				"operationId": "events",
				"summary": "Server-sent event stream",
				"description": "Named events: `task.progress` (TaskProgress), `inbox.new` (InboxItem), `job.state` (JobState), `log` (LogLine). Each frame's data is the JSON payload.",
				"responses": {
					"200": { "description": "Event stream", "content": { "text/event-stream": {} } }
				}
			}
		}
	},
	"components": {
		"schemas": {
			"InboxItem": {
				"type": "object",
				"required": ["id", "kind", "title", "body", "created_at", "read"],
				"properties": {
					"id": { "type": "string" },
					"kind": { "type": "string", "enum": ["info", "warn", "error"] },
					"title": { "type": "string" },
					"body": { "type": "string" },
					"created_at": { "type": "string", "format": "date-time" },
					"read": { "type": "boolean" }
				}
			},
			"TaskStatus": {
				"type": "string",
				"enum": ["downloading", "queued", "stopped", "failed", "completed", "disabled"]
			},
			"TaskProgress": {
				"type": "object",
				"required": ["id", "title", "chapters", "status", "done", "total", "bytes_per_sec"],
				"properties": {
					"id": { "type": "integer", "format": "int64" },
					"title": { "type": "string" },
					"chapters": { "type": "string", "description": "Human readable chapter range, e.g. `Ch. 97–98`" },
					"status": { "$ref": "#/components/schemas/TaskStatus" },
					"done": { "type": "integer", "description": "Pages downloaded" },
					"total": { "type": "integer", "description": "Pages in total" },
					"bytes_per_sec": { "type": "number" }
				}
			},
			"JobState": {
				"type": "object",
				"required": ["id", "title", "state", "done", "total"],
				"properties": {
					"id": { "type": "string" },
					"title": { "type": "string" },
					"state": { "type": "string", "enum": ["running", "idle", "done", "failed"] },
					"done": { "type": "integer" },
					"total": { "type": "integer" }
				}
			},
			"LogLine": {
				"type": "object",
				"required": ["time", "level", "target", "message"],
				"properties": {
					"time": { "type": "string", "format": "date-time" },
					"level": { "type": "string", "enum": ["ERROR", "WARN", "INFO", "DEBUG"] },
					"target": { "type": "string" },
					"message": { "type": "string" }
				}
			},
			"SeriesRef": {
				"type": "object",
				"required": ["module", "link"],
				"properties": {
					"module": { "type": "string", "description": "Module ID" },
					"link": { "type": "string", "description": "Series link relative to the module's RootURL" }
				}
			}
		}
	}
}
