# Copy to .env next to compose.yaml; every value is optional.

# Host port for the web UI.
FMD2R_PORT=8080
# Password/token the API and web UI require; empty for no auth.
FMD2R_PASSWORD=
# Host directory downloads are saved to (must be writable by uid 1000).
MANGA_DIR=./manga
# Image to run, e.g. a release tag: ghcr.io/thundernerd/fmd2r:v0.1.0
FMD2R_IMAGE=ghcr.io/thundernerd/fmd2r:latest
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
TZ=UTC
